# Save a small parameter record, verify it from disk, reload it, and show a detected tamper.
include "../lib/checkpoint/checkpoint.mlpl";

params = {w1: reshape(range(12) * 0.25 - 1, [3, 4]), b1: [0.5, 0.5, 0.5, 0.5], step: 100};
saved = u:ckpt_save("tmp/example-checkpoint", params, {})?;
print("saved", saved.count, "members,", saved.bytes, "bytes:", saved.members);
print("verify:", u:ckpt_verify("tmp/example-checkpoint", {}));
restored = u:ckpt_load("tmp/example-checkpoint", {})?;
print("restored equals saved:", equal(restored, params));
write_atomic(u:ckpt_member_path("tmp/example-checkpoint", "b1"), unwrap(to_native([0.5, 0.5, 0.5, 0.6])))?;
tampered = u:ckpt_verify("tmp/example-checkpoint", {});
print("after tamper:", err_message(tampered).kind, "member", err_message(tampered).member);
tampered
