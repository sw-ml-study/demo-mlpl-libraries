#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
contract=$repo_root/docs/safetensors-header-migration.md
request=$repo_root/docs/demo-ml-utils-requests.md

grep -Fq 'e6d285d1f9903468441feb006cc4c5ad622b9133' "$contract" || { echo "missing demo-ml-utils baseline revision" >&2; exit 1; }
grep -Fq 'e6d285d1f9903468441feb006cc4c5ad622b9133' "$request" || { echo "request does not pin the baseline revision" >&2; exit 1; }
for function in decode_length read_header dtype_width shape_product validate_metadata validate_tensor check_layout parse_header inspect tensor; do
    grep -Fq "u:sth_$function" "$contract" || { echo "missing safetensors header API: $function" >&2; exit 1; }
done
for kind in sth-read sth-prefix sth-length sth-truncated sth-json sth-metadata sth-tensor sth-layout sth-missing; do
    grep -Fq "\`$kind\`" "$contract" || { echo "missing error kind: $kind" >&2; exit 1; }
done
for boundary in 'fs.read-bounded.v1' 'two budgeted reads' 'one bounded header read' '2^53' 'max_header_bytes' 'demo-ml-utils` remains the algorithmic owner' 'GGUF' 'Blocker: none'; do
    grep -Fq "$boundary" "$contract" || { echo "missing safetensors contract boundary: $boundary" >&2; exit 1; }
done
fixture_count=$(grep -c '^| `[a-z-]*\.safetensors` | `[0-9a-f]\{64\}` |' "$contract")
[ "$fixture_count" -eq 20 ] || { echo "expected 20 pinned fixtures, found $fixture_count" >&2; exit 1; }
fixture_dir=$repo_root/tests/fixtures/safetensors
if [ -d "$fixture_dir" ]; then
    copied=$(find "$fixture_dir" -type f -name '*.safetensors' | wc -l | tr -d ' ')
    [ "$copied" -eq 20 ] || { echo "expected 20 copied fixtures, found $copied" >&2; exit 1; }
    for fixture in "$fixture_dir"/*.safetensors; do
        name=$(basename -- "$fixture")
        digest=$(shasum -a 256 "$fixture" | cut -d' ' -f1)
        grep -Fq "| \`$name\` | \`$digest\` |" "$contract" || { echo "fixture digest not pinned by the contract: $name" >&2; exit 1; }
    done
fi
echo "PASS frozen safetensors header migration contract"
